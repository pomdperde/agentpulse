# 与 RagAgent 保持同一套 CHAT_* 约定，换供应商只改这三行。
# CHAT_MODEL 必须是上游认的真实模型名。
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=sk-xxx

# 抓取与筛选
PER_SOURCE_LIMIT=20
MAX_PAPERS=40
DEFAULT_DAYS=14

# 并发与成本闸门
MAX_CONCURRENCY=4
TOKEN_BUDGET=120000

# 可选：Semantic Scholar 提额（不填也能用，限速约 1 rps）
SEMANTIC_SCHOLAR_API_KEY=

# 可选：NCBI PubMed 提额（不填 3 请求/秒，填写后 10 请求/秒）
# 申请地址：https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# 建议填写：OpenAlex / Crossref / NCBI 的礼貌池标识，任意可联系邮箱
CONTACT_EMAIL=

# 网络
REQUEST_TIMEOUT=30
LLM_TIMEOUT=120
HTTP_RETRIES=3
